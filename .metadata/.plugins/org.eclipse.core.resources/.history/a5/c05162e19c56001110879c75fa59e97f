package application;

import java.util.Scanner;

import db.DB;
import model.dao.CopyDao;
import model.dao.impl.CopyDaoJDBC;
import model.entities.Book;
import model.entities.Copy;

public class Program {

	public static void main(String[] args) {

		Scanner sc = new Scanner(System.in);

		CopyDao copyDao = new CopyDaoJDBC(DB.getConnection());

		
		
		
		
		List<Copy> copies = copyDao.findAll();
		
		System.out.println(copies.getId());
		System.out.println(copies.getStatus());
		System.out.println(copies.getBook().getId());
		
		
		
		
		

		sc.close();
	}

}
